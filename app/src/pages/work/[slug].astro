---
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { projects } from '../../content/data';
import { renderProject } from '../../content/render';
import { placeFor } from '../../content/mapping';
import type { Project } from '../../content/types';
export function getStaticPaths() { return projects.map((p) => ({ params: { slug: p.id }, props: { p } })); }
const { p } = Astro.props as { p: Project };
const resumeAvailable = existsSync('public/resume.pdf');
const place = placeFor('project', p.id);
---
<Base title={`${p.title} — Dhruva Mishra`} description={p.summary} path={`/work/${p.id}`}>
  <Header resumeAvailable={resumeAvailable} home={false} />
  <main class="doc" id="main">
    <p class="eyebrow"><a href="/">← The Basin</a> · <a href="/#quick-view">All work</a></p>
    <Fragment set:html={renderProject(p).replace(/^(\s*<article[^>]*>[\s\S]*?)<h2 /, '$1<h1 ').replace(/<\/h2>/, '</h1>')} />
    {place && <p class="basin-link"><a href={`/?site=${place.zoneId}/${place.siteId}`}>See it in the Basin →</a></p>}
  </main>
</Base>
