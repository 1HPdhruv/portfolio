{
  "name": "dhruvas-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:world": "node scripts/build-world.mjs",
    "dev": "pnpm build:world && astro dev",
    "build": "pnpm build:world && astro check && astro build && node scripts/check-dist.mjs",
    "build:qa": "TEST_HOOKS=1 pnpm build:world && TEST_HOOKS=1 astro build",
    "preview": "astro preview",
    "preview:qa": "TEST_HOOKS=1 astro preview --port 4322",
    "test": "vitest run",
    "e2e": "node e2e/e2e.mjs --base http://127.0.0.1:4322",
    "e2e:prod": "node e2e/prod.mjs --base http://127.0.0.1:4321"
  },
  "dependencies": {
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^26.6.5",
    "puppeteer-core": "^25.15.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
